# Firebase Console > プロジェクトの設定 > 全般 > マイアプリ(ウェブ) から取得
# VITE_FIREBASE_STORAGE_BUCKET はサーバー側(Admin SDK)のStorage初期化でも流用する
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- サーバーサイド専用（Vercel Project Settings > Environment Variables で設定） ---
# クライアントには公開されないため VITE_ プレフィックスは付けない。

# Firebase Admin SDK用のサービスアカウント鍵（JSON文字列そのまま）。
# Firebase Console > プロジェクトの設定 > サービスアカウント > 新しい秘密鍵の生成 でダウンロードしたJSONファイルの中身を
# 1行の文字列としてそのまま貼り付ける（例: `FIREBASE_SERVICE_ACCOUNT_KEY=$(cat service-account.json)`）。
FIREBASE_SERVICE_ACCOUNT_KEY=

# Gemini API キー（レシート画像解析用）。Google AI Studio等で発行する。
GEMINI_API_KEY=

# Notion連携（任意）。購入登録のたびにレシート画像・金額・日付をNotionデータベースへ送信する。
# 未設定でも購入登録自体は正常に動作する（Notion同期のみ notSynced/failed 扱いになる）。
# NOTION_TOKEN: https://www.notion.so/my-integrations で作成したIntegrationのトークン
# NOTION_DATABASE_ID: 保存先データベースのURLに含まれる32桁のID
NOTION_TOKEN=
NOTION_DATABASE_ID=
