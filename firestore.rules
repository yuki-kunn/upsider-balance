rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }
    function isOwnFacility(facilityId) {
      return isSignedIn()
             && request.auth.token.role == 'facility'
             && request.auth.token.facilityId == facilityId;
    }
    function canReadFacility(facilityId) {
      // adminは単一施設運用の前提で全施設を読める。施設ロールは自分のfacilityIdのみ読める
      // （Custom Claimsのfacilityidと一致するかを検証し、他施設ドキュメントへの直接読み取りを防ぐ）。
      return isAdmin() || isOwnFacility(facilityId);
    }

    match /facilities/{facilityId} {
      allow read: if canReadFacility(facilityId);
      allow write: if false;

      match /balance/current {
        allow read: if canReadFacility(facilityId);
        allow write: if false;
      }

      match /purchases/{purchaseId} {
        allow read: if canReadFacility(facilityId);
        allow write: if false;
      }
    }

    match /admins/{adminId} {
      allow read, write: if false;
    }

    match /loginAttempts/{docId} {
      allow read, write: if false;
    }

    match /geminiUsage/{docId} {
      allow read, write: if false;
    }
  }
}
